<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 500" width="900" height="500">
  <rect width="900" height="500" fill="#0a192f"/>
  <defs>
    <pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse">
      <path d="M 30 0 L 0 0 0 30" fill="none" stroke="#233554" stroke-width="0.5" opacity="0.3"/>
    </pattern>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <rect width="900" height="500" fill="url(#grid)" />
  
  <text x="450" y="45" font-family="'JetBrains Mono', monospace" font-size="20" font-weight="bold" fill="#64ffda" text-anchor="middle" filter="url(#glow)">TRISHUL SOUNDING ROCKET — DUAL-CONTROLLER AVIONICS ARCHITECTURE</text>
  <text x="450" y="70" font-family="'Nunito', sans-serif" font-size="12" fill="#8892b0" text-anchor="middle">2nd Prize IN-SPACe Model Rocketry 2024-25 • Team Sudarshan</text>

  <!-- Power Domain -->
  <rect x="50" y="100" width="160" height="180" rx="8" fill="#112240" stroke="#233554" stroke-width="1.5"/>
  <text x="130" y="125" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="bold" fill="#ccd6f6" text-anchor="middle">POWER SUBSYSTEM</text>
  <rect x="65" y="145" width="130" height="30" rx="4" fill="#0a192f" stroke="#64ffda" stroke-width="1"/>
  <text x="130" y="165" font-family="'JetBrains Mono', monospace" font-size="10" fill="#64ffda" text-anchor="middle">7.4V Li-Po (2S 1500mAh)</text>
  <rect x="65" y="185" width="130" height="35" rx="4" fill="#0a192f" stroke="#233554"/>
  <text x="130" y="202" font-family="'JetBrains Mono', monospace" font-size="9" fill="#ccd6f6" text-anchor="middle">TPS54331 DC-DC (5V/3A)</text>
  <text x="130" y="214" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Primary Rails</text>
  <rect x="65" y="230" width="130" height="35" rx="4" fill="#0a192f" stroke="#233554"/>
  <text x="130" y="247" font-family="'JetBrains Mono', monospace" font-size="9" fill="#ccd6f6" text-anchor="middle">AMS1117-3.3 LDO (3.3V)</text>
  <text x="130" y="259" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Clean Sensor Power</text>

  <!-- Primary Flight Computer -->
  <rect x="260" y="100" width="220" height="230" rx="8" fill="#112240" stroke="#64ffda" stroke-width="2" filter="url(#glow)"/>
  <text x="370" y="128" font-family="'JetBrains Mono', monospace" font-size="13" font-weight="bold" fill="#64ffda" text-anchor="middle">PRIMARY FLIGHT COMPUTER</text>
  <text x="370" y="146" font-family="'Nunito', sans-serif" font-size="11" font-weight="bold" fill="#ccd6f6" text-anchor="middle">Raspberry Pi Pico 2</text>
  <text x="370" y="160" font-family="'JetBrains Mono', monospace" font-size="9" fill="#8892b0" text-anchor="middle">Dual-Core Arm Cortex-M33 @ 150MHz</text>
  
  <rect x="275" y="175" width="190" height="26" rx="4" fill="#0a192f" stroke="#233554"/>
  <text x="370" y="192" font-family="'JetBrains Mono', monospace" font-size="9" fill="#ccd6f6" text-anchor="middle">Core 0: State Machine &amp; Telemetry</text>
  <rect x="275" y="208" width="190" height="26" rx="4" fill="#0a192f" stroke="#233554"/>
  <text x="370" y="225" font-family="'JetBrains Mono', monospace" font-size="9" fill="#ccd6f6" text-anchor="middle">Core 1: Sensor Polling &amp; FIFO Ring</text>
  <rect x="275" y="241" width="190" height="26" rx="4" fill="#0a192f" stroke="#233554"/>
  <text x="370" y="258" font-family="'JetBrains Mono', monospace" font-size="9" fill="#ccd6f6" text-anchor="middle">MicroSD Card Flight Log (SPI)</text>
  <rect x="275" y="274" width="190" height="42" rx="4" fill="#0a192f" stroke="#64ffda" stroke-width="1"/>
  <text x="370" y="291" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">DUAL PYRO CHANNELS (MOSFET)</text>
  <text x="370" y="305" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Main Chute + Apogee Ejection</text>

  <!-- Secondary Controller -->
  <rect x="260" y="350" width="220" height="110" rx="8" fill="#112240" stroke="#233554" stroke-width="1.5"/>
  <text x="370" y="375" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="bold" fill="#ccd6f6" text-anchor="middle">SECONDARY CONTROLLER</text>
  <text x="370" y="392" font-family="'Nunito', sans-serif" font-size="10" fill="#64ffda" text-anchor="middle">Arduino Nano 33 BLE Sense Rev 2</text>
  <text x="370" y="408" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Arm Cortex-M4F @ 64MHz</text>
  <rect x="275" y="418" width="190" height="28" rx="4" fill="#0a192f" stroke="#233554"/>
  <text x="370" y="435" font-family="'JetBrains Mono', monospace" font-size="9" fill="#ccd6f6" text-anchor="middle">Redundant Apogee Altimetry &amp; Heartbeat</text>

  <!-- Sensor Suite -->
  <rect x="525" y="100" width="165" height="360" rx="8" fill="#112240" stroke="#233554" stroke-width="1.5"/>
  <text x="607" y="125" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="bold" fill="#ccd6f6" text-anchor="middle">SENSOR SUITE</text>
  
  <g transform="translate(540, 140)">
    <rect width="135" height="38" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="67" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">BNO085 (I2C)</text>
    <text x="67" y="30" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">9-DOF Fusion IMU</text>
  </g>

  <g transform="translate(540, 185)">
    <rect width="135" height="38" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="67" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">BMP390 (SPI)</text>
    <text x="67" y="30" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Apogee &amp; Altimeter</text>
  </g>

  <g transform="translate(540, 230)">
    <rect width="135" height="38" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="67" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">INA219 (I2C)</text>
    <text x="67" y="30" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Bus Current &amp; Voltage</text>
  </g>

  <g transform="translate(540, 275)">
    <rect width="135" height="38" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="67" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">MAX31856 (SPI)</text>
    <text x="67" y="30" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Motor Casing Temp</text>
  </g>

  <g transform="translate(540, 320)">
    <rect width="135" height="38" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="67" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">DS3231 (I2C)</text>
    <text x="67" y="30" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">High Precision RTC</text>
  </g>

  <g transform="translate(540, 365)">
    <rect width="135" height="38" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="67" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="bold" fill="#64ffda" text-anchor="middle">NavIC GPS (UART)</text>
    <text x="67" y="30" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Multi-Constellation</text>
  </g>

  <!-- Telemetry Links -->
  <rect x="730" y="100" width="140" height="260" rx="8" fill="#112240" stroke="#233554" stroke-width="1.5"/>
  <text x="800" y="125" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="bold" fill="#ccd6f6" text-anchor="middle">TELEMETRY</text>

  <g transform="translate(740, 145)">
    <rect width="120" height="70" rx="4" fill="#0a192f" stroke="#64ffda" stroke-width="1.5"/>
    <text x="60" y="24" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="bold" fill="#64ffda" text-anchor="middle">XBee S3B Pro</text>
    <text x="60" y="42" font-family="'JetBrains Mono', monospace" font-size="8" fill="#ccd6f6" text-anchor="middle">900MHz RF Link</text>
    <text x="60" y="56" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Primary 10Hz Feed</text>
  </g>

  <g transform="translate(740, 230)">
    <rect width="120" height="70" rx="4" fill="#0a192f" stroke="#233554"/>
    <text x="60" y="24" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="bold" fill="#ccd6f6" text-anchor="middle">Quectel 4G</text>
    <text x="60" y="42" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">EC200U Modem</text>
    <text x="60" y="56" font-family="'JetBrains Mono', monospace" font-size="8" fill="#8892b0" text-anchor="middle">Backup GCS Link</text>
  </g>

  <!-- Connective lines -->
  <path d="M 210 180 L 260 180" stroke="#64ffda" stroke-width="2" stroke-dasharray="4,4"/>
  <path d="M 480 200 L 525 200" stroke="#64ffda" stroke-width="2"/>
  <path d="M 480 260 L 730 180" stroke="#64ffda" stroke-width="2"/>
  <path d="M 370 330 L 370 350" stroke="#233554" stroke-width="2" stroke-dasharray="2,2"/>
</svg>
