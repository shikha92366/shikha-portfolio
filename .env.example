# App Config
NODE_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME="Shikha — ECE Engineer Portfolio"

# Resend (Serverless Contact API)
RESEND_API_KEY=re_123456789_placeholder
CONTACT_RECEIVER_EMAIL=your-email@example.com
CONTACT_SENDER_EMAIL=contact@yourdomain.com

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example_token

# Sentry Error Tracking (Optional)
SENTRY_DSN=

# Sanity CMS (Frontend Read Client & Studio Redirect)
VITE_SANITY_PROJECT_ID=csbgnmwp
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_STUDIO_URL=

# Sanity Migration / Seed Token (CRITICAL: Used ONLY by scripts/seed-sanity.ts)
# NEVER prefix with VITE_ and NEVER commit this token to version control or expose to browser!
SANITY_WRITE_TOKEN=your-sanity-write-or-editor-token

\n